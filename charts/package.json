{
  "name": "chart-snapshot-server",
  "version": "1.0.0",
  "description": "REST API that renders TradingView-sourced candlestick charts to PNG snapshots",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "playwright install chromium",
    "smoke": "node scripts/smoke.js"
  },
  
  "keywords": [
    "chart",
    "candlestick",
    "png",
    "snapshot",
    "tradingview",
    "lightweight-charts"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lightweight-charts": "^4.2.3",
    "playwright": "^1.62.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
